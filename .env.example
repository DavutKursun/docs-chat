# Copy to .env and fill in. Never commit .env.
# Format: KEY=value, one per line; "quoted values" allowed; text after " #" is a comment.

# --- LLM provider ---------------------------------------------------------------
# openai_compat = any OpenAI-compatible Chat Completions endpoint via the `openai` SDK:
#                 Groq, OpenRouter, Mistral, Gemini's OpenAI endpoint, OpenAI itself.
# anthropic     = Claude via the `anthropic` SDK (uses ANTHROPIC_API_KEY, LLM_MODEL
#                 defaults to claude-haiku-5-5; claude-sonnet-5-5 selectable).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# Groq retires model names often (llama-3.3-70b-versatile was already gone on 2026-10-10);
# check https://console.groq.com/docs/models. Model used on 2026-10-10: openai/gpt-oss-120b.
# Other endpoints (check the provider's current model list for LLM_MODEL):
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Mistral     LLM_BASE_URL=https://api.mistral.ai/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Anthropic   LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ------------------------------------------
EMBEDDER=e5                    # e5 | hash (hash = offline toy embedder for tests)
E5_MODEL_NAME=intfloat/multilingual-e5-small
CHUNK_WORDS=350
CHUNK_OVERLAP_WORDS=50
TOP_K=6
CANDIDATES=20
# weak-retrieval note to the LLM: dense cosine threshold (0 = off) and BM25 rule 0 < best score < threshold (0 = off);
# a BM25 score of 0 (e.g. Turkish question on English documents) is never flagged
WEAK_RETRIEVAL_THRESHOLD=0
WEAK_BM25_THRESHOLD=15
MAX_FILES=10
MAX_FILE_MB=20
MAX_TOTAL_PAGES=300
MAX_QUESTIONS_PER_SESSION=20
MAX_DAILY_USD=2
# answers per day for the whole deployment, shared across users (free-tier demo); resets at 00:00 UTC
MAX_DAILY_ANSWERS=150
SESSION_TTL_HOURS=2
# per-session uploads and indexes live here (gitignored); deleted after SESSION_TTL_HOURS
SESSIONS_DIR=sessions
# the sample documents' index is cached here (default: <tmp>/docs-chat/sample-index); rebuilt when the files change
# SAMPLE_INDEX_DIR=/tmp/docs-chat/sample-index
# On Hugging Face Spaces (SPACE_ID is set) this file is ignored, secrets come from the Space settings, and the
# public-demo limits apply unless overridden: MAX_FILES=3 MAX_FILE_MB=10 MAX_TOTAL_PAGES=60.
